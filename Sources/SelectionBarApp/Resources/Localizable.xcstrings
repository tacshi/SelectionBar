        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何应用中选择文本时显示浮动工具栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何應用程式中選取文字時顯示浮動工具列"
