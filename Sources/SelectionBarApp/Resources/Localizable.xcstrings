    "SelectionBar needs Accessibility to read selected text and Input Monitoring to observe global mouse and keyboard events.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SelectionBarは、選択テキストを読み取るためにアクセシビリティ、グローバルなマウスとキーボードのイベントを監視するために入力監視の権限が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SelectionBar 需要“辅助功能”权限来读取选中文本，需要“输入监控”权限来监听全局鼠标和键盘事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SelectionBar 需要「輔助使用」權限來讀取選取的文字，並需要「輸入監控」權限來偵測全系統的滑鼠與鍵盤事件。"
          }
        }
      }
    },
