    "Drag %@ to the list above to allow %@.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ を許可するには、%1$@ を上のリストにドラッグしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %1$@ 拖到上方列表中以允许%2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 %1$@ 拖移至上方列表，以允許%2$@。"
          }
        }
      }
    },
