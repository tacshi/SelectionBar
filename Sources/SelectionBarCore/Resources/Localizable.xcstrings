        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择包含 Command 或 Control 且不含 Fn 的快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇包含 Command 或 Control 且不含 Fn 的快速鍵。"
